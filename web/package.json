{
  "name": "gotham-web",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "test": "node scripts/mock-ws-check.mjs && node scripts/db-web-check.mjs && node scripts/fx15b-check.mjs && node scripts/focus-style-check.mjs && node scripts/jus11-check.mjs && node scripts/jus20-check.mjs && node scripts/ui-truth-check.mjs && npm run test:unit && npm run test:css",
    "test:unit": "vitest run",
    "test:css": "npx playwright install chromium && npx playwright test --config tests/playwright.css.config.ts",
    "e2e": "playwright test",
    "e2e:install": "playwright install --with-deps chromium",
    "lint": "eslint ."
  },
  "dependencies": {
    "@intlify/message-compiler": "11.4.13",
    "@vueuse/core": "^15.0.0",
    "axios": "^1.20.0",
    "lucide-vue-next": "1.0.0",
    "naive-ui": "^2.45.3",
    "pinia": "^3.0.4",
    "vue": "^3.5.43",
    "vue-i18n": "^11.4.13",
    "vue-router": "^4.6.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.4",
    "@typescript-eslint/parser": "^8.71.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.1",
    "typescript": "~5.9.3",
    "vite": "^7.3.6",
    "vitest": "^5.0.3",
    "vue-tsc": "^2.2.12"
  }
}
