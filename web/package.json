    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.1",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "vitest": "^5.0.3",
    "vue-tsc": "^2.2.12"
  }
