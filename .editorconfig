root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.go]
indent_style = tab

[Makefile]
indent_style = tab

[*.md]
trim_trailing_whitespace = false

# The supplied Gotham logo must stay byte-exact: trailing spaces carry the
# artwork's edges and the final line has no newline.
[web/src/features/terminal/assets/*.txt]
trim_trailing_whitespace = false
insert_final_newline = false
